# Copy this file to .env and fill in your own values.
# Never commit .env.

# Required: your image API key.
IMAGEGEN_API_KEY=your-api-key

# Required: the exact image model id accepted by your provider or relay.
IMAGEGEN_MODEL=your-image-model

# Optional: provider root, /v1 base URL, or full /v1/images/generations endpoint.
# Leave empty to use https://api.openai.com.
IMAGEGEN_BASE_URL=

# Optional: choose a default named profile for multi-provider setups.
# Explicit --profile values override this default.
# IMAGEGEN_PROFILE=openai

# Named profiles use IMAGEGEN_PROFILE_<NAME>_*.
# Profile names are case-insensitive in environment variable form; use --profile openai.
# IMAGEGEN_PROFILE_OPENAI_API_KEY=your-openai-api-key
# IMAGEGEN_PROFILE_OPENAI_MODEL=your-openai-image-model
# IMAGEGEN_PROFILE_OPENAI_BASE_URL=https://api.openai.com

# Example relay profile; call with --profile relay.
# IMAGEGEN_PROFILE_RELAY_API_KEY=your-relay-api-key
# IMAGEGEN_PROFILE_RELAY_MODEL=your-relay-image-model
# IMAGEGEN_PROFILE_RELAY_BASE_URL=https://relay.example.com
