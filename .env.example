# Copy this file to .env and fill in your own values.
# Never commit .env.

# Required: your image API key.
IMAGEGEN_API_KEY=your-api-key

# Required: the exact image model id accepted by your provider or relay.
IMAGEGEN_MODEL=your-image-model

# Optional: provider root, /v1 base URL, or full /v1/images/generations endpoint.
# Leave empty to use https://api.openai.com.
IMAGEGEN_BASE_URL=


# Optional: override where generated images are saved.
# Leave empty to save to the installed skill's outputs/ folder.
IGA_OUTPUT_DIR=

